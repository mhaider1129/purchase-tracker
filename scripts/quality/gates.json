    },
    {
      "id": "syntax",
      "group": "backend",
      "kind": "syntax"
    },
    {
      "id": "frozen-history",
      "group": "backend",
      "kind": "history"
    },
    {
      "id": "release-plan",
      "group": "backend",
      "cwd": "purchase-backend",
      "command": ["npm", "run", "db:plan"],
