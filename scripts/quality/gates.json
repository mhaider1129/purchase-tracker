{
  "version": 1,
  "nodeMajor": 22,
  "databaseContract": "hospital-erp-2026-11-scop1",
  "requiredMigrations": ["067", "068", "069", "070", "071", "072"],
  "workers": {
    "rfid": {
      "protocol": "7B",
      "migration": "070",
      "gate": "rfid",
      "source": "services/rfidEventProcessor.js"
    },
    "notifications": {
      "protocol": "7C",
      "migration": "071",
      "gate": "events",
      "source": "services/notificationEmailDelivery.js"
