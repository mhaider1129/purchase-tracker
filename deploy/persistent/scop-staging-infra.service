[Unit]
Description=Approved isolated staging database and HTTPS gateway
Requires=docker.service
After=docker.service network-online.target
RequiresMountsFor=/var/lib/scop-staging
ConditionPathExists=/etc/scop-staging/ACTIVATION_APPROVED

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/scop-staging
EnvironmentFile=/etc/scop-staging/compose.env
ExecStartPre=/bin/sh /opt/scop-staging/verify-storage.sh
ExecStart=/usr/bin/docker compose --profile separately-approved-database --profile separately-approved-gateway --profile separately-approved-egress up -d database gateway egress
ExecStartPost=/bin/sh /opt/scop-staging/firewall.sh
ExecStop=/usr/bin/docker compose stop gateway database egress

[Install]
WantedBy=multi-user.target
